# Copy this file to `.env` at the repo root if you need to override defaults.
# `.env` is gitignored and must never be committed.
#
# HOST and PORT are per process. Do not set them in a shared `.env` if you run
# both the runtime and the UI from this directory; use the defaults or export
# them only in that process's environment.
#
# To point the UI at a Dockerized runtime on this machine:
#   RUNTIME_URL=http://127.0.0.1:8766
# On another host, use that machine's IP or DNS name and publish port 8766.
# The page also has a Model API IP field that overrides this without a restart.

# -----------------------
# Turn runtime (`turn-runtime-serve`)
# -----------------------
# HOST=127.0.0.1
# PORT=8766
# Comma-separated browser origins allowed to call the runtime directly.
# Use * for a container that any UI origin may call.
# CORS_ALLOWED_ORIGINS=http://127.0.0.1:8765,http://localhost:8765
# LOAD_MODEL=true
# WHISPER_MODEL_DIR=models/whisper-tiny
# PAUSE_HEAD_DIR=models/pause_head
# LOG_LEVEL=INFO

# -----------------------
# Turn UI (`turn-ui`)
# -----------------------
# HOST=127.0.0.1
# PORT=8765
# RUNTIME_URL=http://127.0.0.1:8766
# LOG_LEVEL=INFO
